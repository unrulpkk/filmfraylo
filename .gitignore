# Only publish the two source trees and repository metadata.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/LICENSE
!/README.md
!/app/
!/skill/

# Local installation metadata and credentials never belong in source Skills.
**/.env
**/.env.*
!**/.env.example
**/localRuntime.md
**/__pycache__/
**/.DS_Store
