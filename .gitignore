# Publish the root Skill, application source, and repository metadata.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/LICENSE
!/README.md
!/SKILL.md
!/agents/
!/references/
!/scripts/
!/source/

# Local installation metadata and credentials never belong in source Skills.
**/.env
**/.env.*
!**/.env.example
**/localRuntime.md
**/__pycache__/
**/.DS_Store
